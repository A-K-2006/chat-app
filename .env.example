# ============================================================
#  ChatSphere environment template
#  Copy to .env (docker-compose reads it automatically):
#      cp .env.example .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=chatdb
POSTGRES_USER=chat
# CHANGE ME for any non-local deployment
POSTGRES_PASSWORD=chatpass

# --- JWT ---
# REQUIRED: at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
# Optional overrides (defaults: 15 minutes / 7 days, in milliseconds)
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- CORS ---
# Comma-separated frontend origins allowed to call the API / open WebSockets
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# --- Backend datasource (only needed when running the jar OUTSIDE compose) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chatdb
SPRING_DATASOURCE_USERNAME=chat
SPRING_DATASOURCE_PASSWORD=chatpass

# --- File storage (only needed when running the jar outside Docker) ---
UPLOAD_DIR=./uploads

# --- Frontend (Vite) ---
# Leave EMPTY when the API is same-origin (Docker/Nginx or the dev proxy).
# Set to the backend URL when frontend & backend are on different hosts, e.g.
#   VITE_API_URL=https://your-backend.up.railway.app
VITE_API_URL=
